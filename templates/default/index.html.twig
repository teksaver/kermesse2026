{% extends 'base.html.twig' %}

{% block title %}Kermesse 2026{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --sand: #f7f2e7;
            --ink: #1f2937;
            --muted: #6b7280;
            --teal: #0f766e;
            --teal-dark: #115e59;
            --gold: #d97706;
            --card: rgba(255, 255, 255, 0.85);
            --border: rgba(31, 41, 55, 0.12);
            --danger: #b91c1c;
            --success: #166534;
        }

        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Alegreya Sans", "Trebuchet MS", sans-serif;
            color: var(--ink);
            background:
                radial-gradient(circle at top left, rgba(217, 119, 6, 0.25), transparent 30%),
                radial-gradient(circle at top right, rgba(15, 118, 110, 0.2), transparent 30%),
                linear-gradient(135deg, #fffaf0 0%, #f7f2e7 45%, #eef6f5 100%);
        }

        .shell {
            width: min(1120px, calc(100% - 32px));
            margin: 0 auto;
            padding: 40px 0 64px;
        }

        .hero {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 24px;
            align-items: stretch;
        }

        .panel {
            background: var(--card);
            backdrop-filter: blur(14px);
            border: 1px solid var(--border);
            border-radius: 28px;
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
            padding: 30px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(15, 118, 110, 0.2);
            color: var(--teal-dark);
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            font-size: 0.82rem;
        }

        h1 {
            font-family: "Cormorant Garamond", Georgia, serif;
            font-size: clamp(3rem, 6vw, 4.8rem);
            line-height: 0.95;
            margin: 18px 0 16px;
        }

        .lead {
            font-size: 1.15rem;
            line-height: 1.7;
            color: var(--muted);
            max-width: 58ch;
        }

        .status-grid, .auth-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
            margin-top: 24px;
        }

        .status-card {
            border-radius: 20px;
            padding: 20px;
            background: rgba(255, 255, 255, 0.7);
            border: 1px solid var(--border);
        }

        .status-card strong, .auth-card h2 {
            display: block;
            margin-bottom: 10px;
            font-size: 1.05rem;
        }

        .pill {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            border-radius: 999px;
            padding: 8px 14px;
            font-weight: 700;
            background: rgba(22, 101, 52, 0.12);
            color: var(--success);
        }

        .pill.bad {
            background: rgba(185, 28, 28, 0.12);
            color: var(--danger);
        }

        .flash-list {
            display: grid;
            gap: 12px;
            margin: 20px 0 0;
        }

        .flash {
            padding: 14px 16px;
            border-radius: 18px;
            border: 1px solid rgba(31, 41, 55, 0.08);
            background: rgba(255, 255, 255, 0.92);
        }

        .flash.success { border-color: rgba(22, 101, 52, 0.2); color: var(--success); }
        .flash.error { border-color: rgba(185, 28, 28, 0.2); color: var(--danger); }

        .auth-card {
            border-radius: 24px;
            padding: 24px;
            background: rgba(255, 255, 255, 0.76);
            border: 1px solid var(--border);
        }

        .auth-card p {
            color: var(--muted);
            margin-top: 0;
            line-height: 1.6;
        }

        label {
            display: block;
            font-size: 0.95rem;
            font-weight: 700;
            margin-bottom: 8px;
        }

        input[type="email"] {
            width: 100%;
            border-radius: 16px;
            border: 1px solid rgba(31, 41, 55, 0.15);
            padding: 14px 16px;
            font: inherit;
            background: rgba(255, 255, 255, 0.95);
            margin-bottom: 14px;
        }

        button {
            border: 0;
            border-radius: 999px;
            padding: 14px 18px;
            font: inherit;
            font-weight: 700;
            cursor: pointer;
            background: var(--teal);
            color: white;
            width: 100%;
        }

        button.alt { background: var(--gold); }

        .user-box {
            display: grid;
            gap: 14px;
        }

        .table-list {
            margin: 0;
            padding-left: 18px;
            color: var(--muted);
            line-height: 1.6;
        }

        .meta {
            display: grid;
            gap: 10px;
            color: var(--muted);
            font-size: 0.95rem;
        }

        @media (max-width: 900px) {
            .hero, .status-grid, .auth-grid {
                grid-template-columns: 1fr;
            }

            .shell {
                padding-top: 20px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="shell">
        <section class="hero">
            <div class="panel">
                <span class="eyebrow">Kermesse 2026 • Acces membres</span>
                <h1>Comptes par lien magique, sans mot de passe.</h1>
                <p class="lead">
                    Les visiteurs peuvent creer un compte ou se connecter depuis la page d'accueil.
                    Chaque connexion passe par un lien unique envoye par e-mail, puis une session JWT est renouvelee automatiquement jusqu'a la deconnexion explicite.
                </p>

                <div class="status-grid">
                    <article class="status-card">
                        <strong>Etat de la base</strong>
                        <span class="pill {{ isConnected ? '' : 'bad' }}">{{ dbStatus }}</span>
                        <p>{{ dbMessage }}</p>
                    </article>
                    <article class="status-card">
                        <strong>Serveur</strong>
                        <p>PHP {{ constant('PHP_VERSION') }}</p>
                        <p>Derniere verification : {{ "now"|date('d/m/Y H:i:s') }}</p>
                    </article>
                    <article class="status-card">
                        <strong>Tables Doctrine</strong>
                        {% if tables|length > 0 %}
                            <ul class="table-list">
                                {% for t in tables %}
                                    <li>{{ t }}</li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <p>La base est encore vide. Les migrations la rempliront des premieres tables applicatives.</p>
                        {% endif %}
                    </article>
                    <article class="status-card">
                        <strong>Session utilisateur</strong>
                        {% if app.user %}
                            <p>Connecte en tant que <strong>{{ app.user.email }}</strong>.</p>
                            <p>Derniere activite: {{ app.user.lastLoginAt ? app.user.lastLoginAt|date('d/m/Y H:i') : 'premiere connexion' }}</p>
                        {% else %}
                            <p>Aucune session active pour le moment.</p>
                        {% endif %}
                    </article>
                </div>

                <div class="flash-list">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="flash {{ label }}">{{ message }}</div>
                        {% endfor %}
                    {% endfor %}
                </div>
            </div>

            <div class="panel">
                {% if app.user %}
                    <div class="user-box">
                        <span class="eyebrow">Bienvenue</span>
                        <h2 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2.3rem; margin: 0;">{{ app.user.email }}</h2>
                        <div class="meta">
                            <span>Compte verifie : {{ app.user.isVerified ? 'oui' : 'non' }}</span>
                            <span>Cree le {{ app.user.createdAt|date('d/m/Y H:i') }}</span>
                            <span>JWT renouvele automatiquement tant que vous gardez la session ouverte.</span>
                        </div>
                        <form method="post" action="{{ path('app_auth_logout') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('logout') }}">
                            <button type="submit">Se deconnecter</button>
                        </form>
                    </div>
                {% else %}
                    <div class="auth-grid">
                        <article class="auth-card">
                            <h2>Creer un compte</h2>
                            <p>Un compte est initialise en base, puis un lien unique est envoye par e-mail pour valider l'acces.</p>
                            <form method="post" action="{{ path('app_auth_register') }}">
                                <label for="register_email">Adresse e-mail</label>
                                <input id="register_email" type="email" name="email" autocomplete="email" required>
                                <input type="hidden" name="_token" value="{{ csrf_token('register') }}">
                                <button class="alt" type="submit">Recevoir mon lien de creation</button>
                            </form>
                        </article>

                        <article class="auth-card">
                            <h2>Se connecter</h2>
                            <p>Le lien de connexion est a usage unique. Une fois clique, la session JWT se prolonge automatiquement tant que vous ne vous deconnectez pas.</p>
                            <form method="post" action="{{ path('app_auth_login') }}">
                                <label for="login_email">Adresse e-mail</label>
                                <input id="login_email" type="email" name="email" autocomplete="email" required>
                                <input type="hidden" name="_token" value="{{ csrf_token('login') }}">
                                <button type="submit">Recevoir mon lien de connexion</button>
                            </form>
                        </article>
                    </div>
                {% endif %}
            </div>
        </section>
    </div>
{% endblock %}
